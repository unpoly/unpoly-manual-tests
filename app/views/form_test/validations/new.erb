<div class="row">
  <div class="col">

    <h2>Basic form</h2>

    <%= form_tag "/form_test/validation", method: :post, 'up-validate': '' do %>

      <div class="form-group">
        <label for="email">E-mail</label>
        <input type="text" name="email" value="<%= params[:email] %>" class="form-control" id="email">
        <% if invalid_email? %>
          <div class="invalid-feedback" style="display: block">
            Please enter a valid e-mail address
          </div>
        <% end %>
      </div>

      <div class="form-group">
        <label for="prose">Prose</label>
        <textarea name="prose" value="<%= params[:prose] %>" class="form-control" id="prose" rows="3" up-keep up-watch-event="input"><%= params[:prose] %></textarea>
        <% if (params[:prose] || '').size < 30 %>
          <div class="invalid-feedback" style="display: block">
            Enter <b><%= 30 - (params[:prose] || '').size %></b> more characters
          </div>
        <% end %>
      </div>

      <button type="submit" class="btn btn-primary">Submit</button>

    <% end %>

  </div>

</div>
